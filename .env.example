# ---------------------------------------------------------------------------
# EnquiryFlow — environment variables
#
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Neon *pooled* connection string (used by the application at runtime).
# This is the "-pooler" host from the Neon dashboard. Use this in DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon *direct* (non-pooled) connection string (used by `prisma migrate`).
# This is the same endpoint WITHOUT the "-pooler" suffix. Use this in DIRECT_URL.
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXX.REGION.aws.neon.tech/neondb?sslmode=require"
